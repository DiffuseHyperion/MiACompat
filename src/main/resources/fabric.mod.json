{
	"schemaVersion": 1,
	"id": "dmm",
	"version": "${version}",
	"name": "Diffuse's MiA Mod",
	"description": "Experimental QOL mod for the Ghost Seek in the Mine In Abyss Server. Based on HintSystem's MiACompat, named after Danker's Skyblock Mod.",
	"authors": ["DiffuseHyperion", "HintSystem"],
	"contact": {
		"sources": "https://github.com/HintSystem/MiACompat"
	},
	"license": "GNU GPL",
	"icon": "assets/dmm/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.diffusehyperion.dmm.DMM"
		],
        "modmenu": [
			"com.diffusehyperion.dmm.mods.modmenu.SupportModMenu"
        ]
	},
	"mixins": [
		"miacompat.mixins.json"
	],
	"depends": {
		"java": ">=21",
		"minecraft": "1.21.11",
		"fabricloader": ">=0.18.0",
		"fabric-api": "*",
        "yet_another_config_lib_v3": "*"
	}
}